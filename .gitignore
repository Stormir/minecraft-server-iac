# Terraform local files
.terraform/
terraform/.terraform/
*.tfstate
*.tfstate.*
.terraform.tfstate.lock.info
terraform.tfstate.backup

# Terraform variable files
# These can contain local settings or sensitive values, so I am not committing them.
*.tfvars
*.tfvars.json
!terraform.tfvars.example

# Terraform override files
override.tf
override.tf.json
*_override.tf
*_override.tf.json

# Terraform crash logs
crash.log
crash.*.log

# Terraform CLI config files
.terraformrc
terraform.rc

# Ansible local files
ansible/inventory.ini

# SSH keys
*.pem
*.ppk
id_rsa
id_rsa.pub
minecraft_iac_key
minecraft_iac_key.pub

# AWS credentials and local environment files
.env
*.env
.aws/


# OS/editor files
.DS_Store
Thumbs.db
.vscode/